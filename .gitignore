# Secrets. Each user brings their own Pixabay key (README -> Setup); the repo
# ships .env.example and nothing else. See CLAUDE.md -> Pixabay rules.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Crivo's own working data: cached search responses, downloaded originals
# and the resumable session. Pixabay images must never be committed
# (CLAUDE.md -> Pixabay rules), so this is ignored wholesale rather than by
# file type.
.crivo/
crivo-output/
*.zip
# Pre-rename (CRIVO-1) default work-dir name; ignored so a checkout that still
# has one lying around from before the rename doesn't show up as untracked.
.winnower/
winnower-output/

# Claude Code: per-machine state, not project configuration.
.claude/settings.local.json
.claude/scheduled_tasks.lock
